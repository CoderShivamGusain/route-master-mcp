{
  "manifest_version": 3,
  "name": "route-master",
  "version": "0.8.1",
  "description": "Lets your AI assistant book buses for you on redBus and MakeMyTrip, in your own Chrome. You always pay yourself.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "route-master" },
  "permissions": ["identity", "storage", "tabs", "scripting", "alarms", "debugger", "background"],
  "host_permissions": [
    "https://*.redbus.in/*",
    "https://*.makemytrip.com/*",
    "https://mcp-route-master.onrender.com/*"
  ]
}
